NODE_ENV=development

# Operational environment: staging or production
SDG_ENV=staging

# Public dashboard data source. Must point to approved data only.
PUBLIC_SDG_DATA_PATH=data/approved/2025_RW-SDG_Data.xlsx

# Optional: Python executable for Open SDG scripts (recommended on Windows if multiple Python versions exist)
# SDG_PYTHON_EXECUTABLE=C:\\Users\\<you>\\AppData\\Local\\Programs\\Python\\Python311\\python.exe

# Admin Data Ingestion module (admin-only access)
ADMIN_AUTH_SECRET=change-this-admin-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Set true only when serving the admin over HTTPS.
ADMIN_COOKIE_SECURE=false

# AI provider for mapping suggestions: auto | openai | gemini | openrouter
AI_PROVIDER=auto
AI_FAST_MODE=true
AI_MAX_TABLES_PER_RUN=6
# Keep automation usable when an AI broker is slow, over quota, or returns invalid JSON.
# Fallback suggestions are intentionally low-confidence and require manual review.
ALLOW_HEURISTIC_FALLBACK=true
# After one broker failure, skip more broker calls briefly and create review suggestions.
AI_PROVIDER_COOLDOWN_MS=300000

# OpenAI API for AI mapping suggestions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=25000

# OpenRouter API for AI mapping suggestions
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_MODEL_FALLBACKS=openrouter/free,openai/gpt-oss-120b:free,deepseek/deepseek-v4-flash:free
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_TOKENS=1200
OPENROUTER_TIMEOUT_MS=25000
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gemini API for AI mapping suggestions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional comma-separated fallback models and retry count for temporary overloads
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.0-flash-lite,gemini-2.0-flash
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_MS=25000

# NISR website auto-import crawler settings
NISR_IMPORT_MIN_YEAR=2000
NISR_IMPORT_CRAWL_DEPTH=3
NISR_IMPORT_MAX_PAGES_PER_SOURCE=120
NISR_IMPORT_MAX_MB=60

# Optional base URL for weekly sync script
# SDG_BASE_URL=http://localhost:3000
